{
  "name": "neural-git-tui",
  "version": "1.0.0",
  "description": "Bio-inspired git visualization — Neural Network / Synaptic Firing metaphor",
  "main": "dist/index.js",
  "bin": {
    "neural-git": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "package": "pkg dist/index.js --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --output neural-git",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run build && npm test"
  },
  "keywords": [
    "git",
    "visualization",
    "tui",
    "terminal",
    "neural",
    "bio"
  ],
  "author": "Pedro Belentani",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "blessed": "^0.1.81",
    "simple-git": "^3.25.0",
    "d3-force": "^3.0.0",
    "chalk": "^5.3.0",
    "cli-truncate": "^3.1.0",
    "date-fns": "^3.6.0",
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.24",
    "@types/d3-force": "^3.0.0",
    "@types/diff": "^5.2.1",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "tsx": "^4.15.0",
    "pkg": "^5.8.1"
  },
  "engines": {
    "node": ">=18"
  }
}
